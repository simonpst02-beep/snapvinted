<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SpyEbay · meilleure affaire"
        android:textColor="#8B8FA3"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/w_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="–"
        android:textColor="#34D399"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ouvre l'appli pour chercher"
        android:textColor="#F4F5FB"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bénéfice du mois : 0 €"
        android:textColor="#22D3EE"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
